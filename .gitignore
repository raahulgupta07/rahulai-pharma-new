# Virtual environments
venv/
.venv/

# Python caches
__pycache__/
*.pyc

# Environment
.env
# Generated by deploy/aws/install.sh: OpenRouter key, admin password, DB password.
# .env.prod.example is the committed template; .env.prod itself never is.
.env.prod

# Local backups written by deploy/aws/backup.sh
backups/

# Test cache
.pytest_cache/

# Databases
*.db

# Data files (keep the directory placeholder)
data/*.xlsx
!data/.gitkeep

# macOS
.DS_Store

# Packaging
*.egg-info/
dist/
build/

# ---- local-only, never shipped -------------------------------------------
# Database dumps and SFTP archives taken before destructive operations. The
# 20260818 dump alone is 211 MB — past GitHub's 100 MB per-file hard limit, so
# committing this directory does not fail late, it fails the push outright.
_backups/
admin/_backups/

# Generated knowledge graph. `graphify` rebuilds it from the tree; 123 files and
# 6 MB of derived data that would churn on every run.
graphify-out/

# Local agent skills and configuration — this machine's tooling, not the product.
.claude/

# Scratch from auth debugging.
authtest/
